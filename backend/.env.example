# ==============================================================================
# FastSales WhatsApp Backend Environment Configuration Template
# Copy this file to .env and fill in your actual credentials before running:
# cp .env.example .env
# ==============================================================================

# ─── Application Settings ───────────────────────────────────────────────────
APP_NAME="FastSales WhatsApp Module"
APP_VERSION="1.0.0"
DEBUG=false
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app

# ─── Authentication / Security (REQUIRED) ──────────────────────────────────
# Generate a strong 32+ character random string for production JWT signing
JWT_SECRET_KEY=replace_with_a_secure_random_jwt_secret_key_32_chars_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database Configuration ────────────────────────────────────────────────
# PostgreSQL Connection URL format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fastsales_whatsapp
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30

# ─── Redis & Celery Background Workers ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Meta / WhatsApp Cloud API Credentials ────────────────────────────────
META_API_VERSION=v23.0
META_BASE_URL=https://graph.facebook.com
META_VERIFY_TOKEN=your_custom_webhook_verify_token_here
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_WEBHOOK_SKIP_SIGNATURE=false

# Optional Legacy Single-WABA Defaults (Dynamic multi-tenant WABA accounts managed via DB)
# ACCESS_TOKEN=
# PHONE_NUMBER_ID=
# WABA_ID=

# ─── Cloud Storage (AWS S3) Configuration ──────────────────────────────────
# Set STORAGE_PROVIDER to "s3" for AWS S3 cloud storage or "local" for disk
STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=fastsales-media-bucket
S3_CUSTOM_DOMAIN=

# ─── Scheduler ────────────────────────────────────────────────────────────
# Set to false when using Celery Beat (recommended)
ENABLE_SCHEDULER=false
